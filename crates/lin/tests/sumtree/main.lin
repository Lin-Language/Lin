// sumtree demo — build a small expression tree and evaluate it.
//
// Run:   lin run crates/lin/tests/sumtree/main.lin
// Test:  lin test crates/lin/tests/sumtree/
import { print } from "std/io"
import { Expr, eval, num, binOp, ADD, SUB, MUL } from "./ast"

// ((3 + 4) * (10 - 6)) = 28, built inline.
val tree: Expr = {
  "kind": "op",
  "op": 2,
  "left": {
    "kind": "op",
    "op": 0,
    "left": { "kind": "num", "value": 3 },
    "right": { "kind": "num", "value": 4 }
  },
  "right": {
    "kind": "op",
    "op": 1,
    "left": { "kind": "num", "value": 10 },
    "right": { "kind": "num", "value": 6 }
  }
}
print(eval(tree))

// The SAME tree, but every node is built inside a function and returned. Prints 28 as well.
val built: Expr = binOp(MUL, binOp(ADD, num(3), num(4)), binOp(SUB, num(10), num(6)))
print(eval(built))
