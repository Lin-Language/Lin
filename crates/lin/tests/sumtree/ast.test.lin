import { expect, toBe, test, suite, run } from "std/test"
import { range, reduce } from "std/iter"
import { toString } from "std/string"
import { Expr, Num, BinOp, eval, num, binOp, chain, ADD, SUB, MUL } from "./ast"

// A parser-style cursor record: a sum-typed `node` field beside a scalar `pos`.
type Cursor = { "node": Expr, "pos": Int32 }

val leaf3: Expr = { "kind": "num", "value": 3 }
val leaf4: Expr = { "kind": "num", "value": 4 }

// ((3 + 4) * (10 - 6)) = 28
val product = (): Expr => binOp(MUL, binOp(ADD, num(3), num(4)), binOp(SUB, num(10), num(6)))

val s = suite("sumtree", [
  test("a bare number evaluates to itself", () => [
    expect(eval(leaf3)).toBe(3)
  ]),

  test("addition over two leaves", () =>
    val t: Expr = {
      "kind": "op",
      "op": 0,
      "left": leaf3,
      "right": leaf4
    }
    [expect(eval(t)).toBe(7)]
  ),

  test("nested mixed-op tree ((3+4)*(10-6)) = 28", () =>
    val t: Expr = {
      "kind": "op",
      "op": 2,
      "left": {
        "kind": "op",
        "op": 0,
        "left": { "kind": "num", "value": 3 },
        "right": { "kind": "num", "value": 4 }
      },
      "right": {
        "kind": "op",
        "op": 1,
        "left": { "kind": "num", "value": 10 },
        "right": { "kind": "num", "value": 6 }
      }
    }
    [expect(eval(t)).toBe(28)]
  ),

  test("repeated build + eval + drop is leak-free", () =>
    // Build and drop a fresh tree several times; a leak or double-free in the
    // recursive drop walk would corrupt a later iteration's result.
    val total = range(0, 5).reduce(0, (acc, i) =>
      val t: Expr = {
        "kind": "op",
        "op": 0,
        "left": { "kind": "num", "value": i },
        "right": { "kind": "num", "value": 1 }
      }
      acc + eval(t)
    )
    // sum of (i + 1) for i in 0..4 = 1+2+3+4+5 = 15
    [expect(total).toBe(15)]
  ),

  test("a tree built+returned from functions evaluates correctly", () => [
    expect(eval(product())).toBe(28)
  ]),

  // `chain(n)` builds a left-leaning spine; evaluating sums its `n` leaf 1's.
  test("a built spine evaluates correctly", () => [
    expect(eval(chain(1))).toBe(1),
    expect(eval(chain(7))).toBe(7)
  ]),

  test("repeated build-and-return + drop is leak-free", () =>
    val total = range(0, 5).reduce(0, (acc, i) => acc + eval(binOp(ADD, num(i), num(1))))
    [expect(total).toBe(15)]
  ),

  // A sum value crossing a CONTAINER boundary (a record field, a `{String:Expr}` map) must
  // store and read back as the same tree, so it evaluates to the same value.
  test("a tree stored in a cursor record reads back + evaluates correctly", () =>
    val cur: Cursor = { "node": product(), "pos": 7 }
    [
      expect(eval(cur["node"])).toBe(28),
      expect(cur["pos"]).toBe(7)
    ]
  ),

  test("a tree stored in a {String:Expr} map reads back + evaluates correctly", () =>
    val m: { String: Expr } = {}
    m["root"] = binOp(ADD, num(3), num(4))
    val back = m["root"]
    val r = match back
      is Num => eval(back)
      is BinOp => eval(back)
      else => -1
    [expect(r).toBe(7)]
  ),

  test("repeated cursor-record store + read + eval is leak-free", () =>
    val total = range(0, 50).reduce(0, (acc, i) =>
      val cur: Cursor = { "node": binOp(ADD, num(i), num(1)), "pos": i }
      acc + eval(cur["node"])
    )
    // sum of (i + 1) for i in 0..49 = (49*50/2) + 50 = 1275
    [expect(total).toBe(1275)]
  ),

  // The UNTYPED-object store: the binding has no type annotation, so its inferred type is a
  // plain object (not a named record). Reading the sum value back must yield the real tree.
  test("a tree stored in an UNTYPED object reads back + evaluates correctly", () =>
    val cursor = { "node": product(), "pos": 7 }
    val back: Expr = cursor["node"]
    [expect(eval(back)).toBe(28)]
  ),

  test("a tree stored in an UNTYPED object reads back + toStrings correctly", () =>
    val cursor = { "node": binOp(ADD, num(3), num(4)), "pos": 0 }
    [
      // toString serialises object fields in declaration order.
      expect(cursor["node"].toString()).toBe(
        "{\"kind\": \"op\", \"op\": 0, \"left\": {\"kind\": \"num\", \"value\": 3}, \"right\": {\"kind\": \"num\", \"value\": 4}}"
      )
    ]
  ),

  test("repeated UNTYPED-object store + read + eval is leak-free", () =>
    val total = range(0, 50).reduce(0, (acc, i) =>
      val cursor = { "node": binOp(ADD, num(i), num(1)), "pos": i }
      val back: Expr = cursor["node"]
      acc + eval(back)
    )
    // sum of (i + 1) for i in 0..49 = 1275
    [expect(total).toBe(1275)]
  )
])

run(s)
