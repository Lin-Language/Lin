import { expect, toBe, test, suite } from "std/test"

export val tests = (solve: (String) => Int32): AnyVal =>
  suite("15-roman-to-int", [
    test("III = 3", () =>
      [expect(solve("III")).toBe(3)]
    ),

    test("IV = 4", () =>
      [expect(solve("IV")).toBe(4)]
    ),

    test("IX = 9", () =>
      [expect(solve("IX")).toBe(9)]
    ),

    test("LVIII = 58", () =>
      [expect(solve("LVIII")).toBe(58)]
    ),

    test("MCMXCIV = 1994", () =>
      [expect(solve("MCMXCIV")).toBe(1994)]
    ),

    test("single symbol M = 1000", () =>
      [expect(solve("M")).toBe(1000)]
    ),

    test("I = 1", () =>
      [expect(solve("I")).toBe(1)]
    ),

    test("XL = 40", () =>
      [expect(solve("XL")).toBe(40)]
    ),

    test("XC = 90", () =>
      [expect(solve("XC")).toBe(90)]
    ),

    test("CD = 400", () =>
      [expect(solve("CD")).toBe(400)]
    ),

    test("CM = 900", () =>
      [expect(solve("CM")).toBe(900)]
    ),

    test("MMMDCCCLXXXVIII = 3888 (largest common)", () =>
      [expect(solve("MMMDCCCLXXXVIII")).toBe(3888)]
    )
  ])
