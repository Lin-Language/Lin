// Climbing Stairs
//
// Count the number of distinct ways to climb exactly n steps, where each move
// is either 1 or 2 steps. solve(0) = 1 (one way: take no steps).
// Use a DP loop, not recursion.
//
// Signature:
//   solve(n: Int32): Int32
//
// Examples:
//   solve(0)    // 1
//   solve(1)    // 1
//   solve(2)    // 2
//   solve(3)    // 3
//   solve(5)    // 8
//   solve(10)   // 89

export val solve = (n: Int32): Int32 =>
  1
