import { expect, toBe, test, suite } from "std/test"

export val tests = (solve: (Int32) => Int32): AnyVal =>
  suite("19-climb-stairs", [
    test("0 steps = 1 way", () =>
      [expect(solve(0)).toBe(1)]
    ),

    test("1 step = 1 way", () =>
      [expect(solve(1)).toBe(1)]
    ),

    test("2 steps = 2 ways", () =>
      [expect(solve(2)).toBe(2)]
    ),

    test("3 steps = 3 ways", () =>
      [expect(solve(3)).toBe(3)]
    ),

    test("5 steps = 8 ways", () =>
      [expect(solve(5)).toBe(8)]
    ),

    test("10 steps = 89 ways", () =>
      [expect(solve(10)).toBe(89)]
    ),

    test("4 steps = 5 ways", () =>
      [expect(solve(4)).toBe(5)]
    ),

    test("6 steps = 13 ways", () =>
      [expect(solve(6)).toBe(13)]
    ),

    test("20 steps = 10946 ways", () =>
      [expect(solve(20)).toBe(10946)]
    ),

    test("30 steps = 1346269 ways", () =>
      [expect(solve(30)).toBe(1346269)]
    )
  ])
