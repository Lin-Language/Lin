// Keep the Evens
//
// Return a new array containing only the even-valued elements of xs,
// preserving their original order. Zero is considered even.
//
// Signature:
//   solve(xs: Int32[]): Int32[]
//
// Examples:
//   solve([1, 2, 3, 4, 5, 6])   // [2, 4, 6]
//   solve([1, 3, 5])             // []
//   solve([])                    // []
//   solve([2])                   // [2]

import { filter } from "std/iter"

export val solve = (xs: Int32[]): Int32[] =>
  val r: Int32[] = []
  r
