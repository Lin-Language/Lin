// Group Anagrams
//
// Given an array of strings, group words that are anagrams of each other
// (same letters in any order). Return the groups in order of first appearance;
// within each group, preserve the input order.
//
// Signature:
//   solve(words: String[]): String[][]
//
// Examples:
//   solve(["eat", "tea", "tan", "ate", "nat", "bat"])
//     // [["eat", "tea", "ate"], ["tan", "nat"], ["bat"]]
//   solve([])    // []
//   solve(["x"]) // [["x"]]

import { split, join } from "std/string"
import { sort, push, length } from "std/array"

export val solve = (words: String[]): String[][] =>
  []
