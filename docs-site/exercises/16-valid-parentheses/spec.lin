import { expect, toBe, test, suite } from "std/test"
import { range, reduce } from "std/iter"

export val tests = (solve: (String) => Boolean): AnyVal =>
  suite("16-valid-parentheses", [
    test("simple parens", () =>
      [expect(solve("()")).toBe(true)]
    ),

    test("mixed brackets", () =>
      [expect(solve("()[]{}")).toBe(true)]
    ),

    test("mismatched", () =>
      [expect(solve("(]")).toBe(false)]
    ),

    test("interleaved brackets", () =>
      [expect(solve("([)]")).toBe(false)]
    ),

    test("nested brackets", () =>
      [expect(solve("{[]}")).toBe(true)]
    ),

    test("empty string", () =>
      [expect(solve("")).toBe(true)]
    ),

    test("unclosed", () =>
      [expect(solve("(")).toBe(false)]
    ),

    test("just close", () =>
      [expect(solve(")")).toBe(false)]
    ),

    test("deeply nested valid", () =>
      [expect(solve("(((())))")).toBe(true)]
    ),

    test("deeply nested invalid", () =>
      [expect(solve("(((()))))(")).toBe(false)]
    ),

    test("large valid: 500 pairs of ()", () =>
      [expect(solve(range(0, 500).reduce("", (acc, _) => "${acc}()"))).toBe(true)]
    ),

    test("large invalid: 500 open parens", () =>
      [expect(solve(range(0, 500).reduce("", (acc, _) => "${acc}("))).toBe(false)]
    )
  ])
