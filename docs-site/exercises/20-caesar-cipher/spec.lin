import { expect, toBe, test, suite } from "std/test"
import { range, reduce } from "std/iter"

export val tests = (solve: (String, Int32) => String): AnyVal =>
  suite("20-caesar-cipher", [
    test("shift by 1", () =>
      [expect(solve("abc", 1)).toBe("bcd")]
    ),

    test("wraps at z", () =>
      [expect(solve("xyz", 3)).toBe("abc")]
    ),

    test("mixed case and punctuation", () =>
      [expect(solve("Hello, World!", 5)).toBe("Mjqqt, Btwqi!")]
    ),

    test("zero shift", () =>
      [expect(solve("abc", 0)).toBe("abc")]
    ),

    test("shift >= 26", () =>
      [expect(solve("abc", 26)).toBe("abc")]
    ),

    test("empty string", () =>
      [expect(solve("", 3)).toBe("")]
    ),

    test("uppercase wraps at Z", () =>
      [expect(solve("XYZ", 3)).toBe("ABC")]
    ),

    test("digits unchanged", () =>
      [expect(solve("a1b2", 1)).toBe("b1c2")]
    ),

    test("shift 13 is ROT13", () =>
      [expect(solve(solve("Hello", 13), 13)).toBe("Hello")]
    ),

    test("large shift: shift 52 is identity", () =>
      [expect(solve("abcXYZ", 52)).toBe("abcXYZ")]
    )
  ])
