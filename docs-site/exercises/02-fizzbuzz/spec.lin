import { expect, toBe, test, suite } from "std/test"
import { range, map, filter } from "std/iter"
import { length } from "std/array"

export val tests = (solve: (Int32) => String[]): AnyVal =>
  suite("02-fizzbuzz", [
    test("n=5 produces first five entries", () =>
      [expect(solve(5)).toBe(["1", "2", "Fizz", "4", "Buzz"])]
    ),

    test("n=0 returns empty array", () => [expect(solve(0)).toBe([])]),

    test("n=1 returns just '1'", () => [expect(solve(1)).toBe(["1"])]),

    test("n=15 ends with FizzBuzz", () =>
      [
        expect(solve(15)).toBe([
          "1", "2", "Fizz", "4", "Buzz",
          "Fizz", "7", "8", "Fizz", "Buzz",
          "11", "Fizz", "13", "14", "FizzBuzz"
        ])
      ]
    ),

    test("n=3 last element is Fizz", () =>
      [expect(solve(3)).toBe(["1", "2", "Fizz"])]
    ),

    test("n=30 has exactly 2 FizzBuzz entries", () =>
      [expect(length(solve(30).filter(s => s == "FizzBuzz"))).toBe(2)]
    ),

    test("large input: n=300 has correct length", () =>
      [expect(length(solve(300))).toBe(300)]
    ),

    test("large input: n=300 entry at index 14 (i=15) is FizzBuzz", () =>
      [expect(solve(300)[14]).toBe("FizzBuzz")]
    )
  ])
