import { expect, toBe, test, suite } from "std/test"
import { range, map } from "std/iter"

export val tests = (solve: (Int32[]) => Int32): AnyVal =>
  suite("30-trapping-rain-water", [
    test("classic 12-bar example gives 6", () => [
      expect(solve([0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1])).toBe(6)
    ]),

    test("6-bar example gives 9", () => [expect(solve([4, 2, 0, 3, 2, 5])).toBe(9)]),

    test("empty array gives 0", () => [expect(solve([])).toBe(0)]),

    test("monotone ascending traps 0", () => [expect(solve([1, 2, 3])).toBe(0)]),

    test("monotone descending traps 0", () => [expect(solve([3, 2, 1])).toBe(0)]),

    test("single bar gives 0", () => [expect(solve([5])).toBe(0)]),

    test("two bars give 0", () => [expect(solve([3, 5])).toBe(0)]),

    test("flat bottom between two peaks", () => [expect(solve([3, 0, 0, 3])).toBe(6)]),

    test("all zeros", () => [expect(solve([0, 0, 0])).toBe(0)]),

    test("symmetric valley", () => [expect(solve([5, 1, 5])).toBe(4)]),

    test("large flat profile: peaks at ends, 998 zeros in middle", () =>
      [expect(solve(
        range(0, 1000).map(i => if i == 0 || i == 999 then 10 else 0)
      )).toBe(9980)]
    )
  ])
