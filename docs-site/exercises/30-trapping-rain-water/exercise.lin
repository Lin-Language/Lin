// Trapping Rain Water
//
// Given an array of bar heights, compute how many units of water are trapped
// between the bars after a rain. Water above bar i is bounded by the minimum
// of the tallest bar to its left and the tallest bar to its right.
// Return 0 for an empty array or a monotone sequence.
//
// Signature:
//   solve(heights: Int32[]): Int32
//
// Examples:
//   solve([0,1,0,2,1,0,1,3,2,1,2,1])   // 6
//   solve([4,2,0,3,2,5])               // 9
//   solve([])                          // 0
//   solve([1,2,3])                     // 0

export val solve = (heights: Int32[]): Int32 =>
  0
