import { expect, toBe, test, suite } from "std/test"
import { range, reduce } from "std/iter"

export val tests = (solve: (String) => String): AnyVal =>
  suite("17-run-length-encode", [
    test("mixed runs", () =>
      [expect(solve("aaabbc")).toBe("a3b2c1")]
    ),

    test("all singletons", () =>
      [expect(solve("abc")).toBe("a1b1c1")]
    ),

    test("empty string", () =>
      [expect(solve("")).toBe("")]
    ),

    test("single run", () =>
      [expect(solve("aaaa")).toBe("a4")]
    ),

    test("longer mixed", () =>
      [expect(solve("aabbcc")).toBe("a2b2c2")]
    ),

    test("single character", () =>
      [expect(solve("z")).toBe("z1")]
    ),

    test("alternating characters", () =>
      [expect(solve("ababab")).toBe("a1b1a1b1a1b1")]
    ),

    test("large uniform run of 100 chars", () =>
      [expect(solve(range(0, 100).reduce("", (acc, _) => "${acc}x"))).toBe("x100")]
    )
  ])
