import { expect, toBe, test, suite } from "std/test"

export val tests = (solve: (Int32[], Int32) => Int32): AnyVal =>
  suite("24-coin-change", [
    test("coins [1,2,5] amount 11 gives 3", () => [
      expect(solve([1, 2, 5], 11)).toBe(3)
    ]),

    test("impossible gives -1", () => [expect(solve([2], 3)).toBe(-1)]),

    test("amount 0 gives 0", () => [expect(solve([1], 0)).toBe(0)]),

    test("coins [1,5,10,25] amount 30 gives 2", () => [
      expect(solve([1, 5, 10, 25], 30)).toBe(2)
    ]),

    test("single coin exact match", () => [
      expect(solve([5], 5)).toBe(1)
    ]),

    test("single coin multiple", () => [
      expect(solve([5], 20)).toBe(4)
    ]),

    test("single coin impossible", () => [
      expect(solve([3], 7)).toBe(-1)
    ]),

    test("greedy fails: [1,3,4] amount 6 gives 2 not 3", () => [
      expect(solve([1, 3, 4], 6)).toBe(2)
    ]),

    test("large amount: coins [1,5,10,25] amount 200 gives 8", () => [
      expect(solve([1, 5, 10, 25], 200)).toBe(8)
    ]),

    test("large amount: coins [2] amount 1000 gives 500", () => [
      expect(solve([2], 1000)).toBe(500)
    ])
  ])
