import { expect, toBe, test, suite } from "std/test"
import { range, map } from "std/iter"
import { length } from "std/array"

export val tests = (solve: (Int32[], Int32[]) => Int32[]): AnyVal =>
  suite("13-merge-sorted", [
    test("merges two disjoint arrays", () =>
      [expect(solve([1, 3, 5], [2, 4, 6])).toBe([1, 2, 3, 4, 5, 6])]
    ),

    test("first array empty", () =>
      [expect(solve([], [1, 2])).toBe([1, 2])]
    ),

    test("second array empty", () =>
      [expect(solve([5], [])).toBe([5])]
    ),

    test("keeps duplicates", () =>
      [expect(solve([1, 1], [1])).toBe([1, 1, 1])]
    ),

    test("overlapping ranges", () =>
      [expect(solve([1, 3, 5], [2, 3, 4])).toBe([1, 2, 3, 3, 4, 5])]
    ),

    test("both empty", () =>
      [expect(solve([], [])).toBe([])]
    ),

    test("all from first, second has larger elements", () =>
      [expect(solve([1, 2], [3, 4])).toBe([1, 2, 3, 4])]
    ),

    test("large input: even vs odd numbers up to 999", () =>
      [expect(length(solve(range(0, 500).map(i => i * 2), range(0, 500).map(i => i * 2 + 1)))).toBe(1000)]
    ),

    test("large input: result first element is 0", () =>
      [expect(solve(range(0, 500).map(i => i * 2), range(0, 500).map(i => i * 2 + 1))[0]).toBe(0)]
    ),

    test("large input: result last element is 999", () =>
      [expect(solve(range(0, 500).map(i => i * 2), range(0, 500).map(i => i * 2 + 1))[999]).toBe(999)]
    )
  ])
