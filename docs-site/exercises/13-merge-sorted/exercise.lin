// Merge Two Sorted Arrays
//
// Given two ascending-sorted arrays a and b, return a single ascending-sorted
// array containing all elements from both (duplicates included).
// Either input may be empty.
//
// Signature:
//   solve(a: Int32[], b: Int32[]): Int32[]
//
// Examples:
//   solve([1, 3, 5], [2, 4, 6])   // [1, 2, 3, 4, 5, 6]
//   solve([], [1, 2])             // [1, 2]
//   solve([1, 1], [1])            // [1, 1, 1]
//   solve([5], [])                // [5]

export val solve = (a: Int32[], b: Int32[]): Int32[] =>
  []
