// Top K Frequent Elements
//
// Given an array of integers and a value k, return exactly k elements ordered
// by frequency descending. Break ties by value ascending.
// You may assume k <= the number of distinct values.
//
// Signature:
//   solve(xs: Int32[], k: Int32): Int32[]
//
// Examples:
//   solve([1,1,1,2,2,3], 2)   // [1, 2]
//   solve([4,4,5,5,6], 2)     // [4, 5]
//   solve([7], 1)             // [7]
//   solve([1,2,2,3,3], 2)     // [2, 3]

export val solve = (xs: Int32[], k: Int32): Int32[] =>
  val r: Int32[] = []
  r
