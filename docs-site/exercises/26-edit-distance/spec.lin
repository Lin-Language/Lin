import { expect, toBe, test, suite } from "std/test"
import { range, reduce } from "std/iter"

export val tests = (solve: (String, String) => Int32): AnyVal =>
  suite("26-edit-distance", [
    test("horse to ros is 3", () => [expect(solve("horse", "ros")).toBe(3)]),

    test("intention to execution is 5", () => [
      expect(solve("intention", "execution")).toBe(5)
    ]),

    test("empty to abc is 3", () => [expect(solve("", "abc")).toBe(3)]),

    test("identical strings is 0", () => [expect(solve("abc", "abc")).toBe(0)]),

    test("abc to empty is 3", () => [expect(solve("abc", "")).toBe(3)]),

    test("both empty is 0", () => [expect(solve("", "")).toBe(0)]),

    test("single insertion", () => [expect(solve("a", "ab")).toBe(1)]),

    test("single deletion", () => [expect(solve("ab", "a")).toBe(1)]),

    test("single substitution", () => [expect(solve("a", "b")).toBe(1)]),

    test("large: 100-char identical strings", () =>
      [expect(solve(
        range(0, 100).reduce("", (acc, _) => "${acc}a"),
        range(0, 100).reduce("", (acc, _) => "${acc}a")
      )).toBe(0)]
    ),

    test("large: 100 a's to 100 b's costs 100", () =>
      [expect(solve(
        range(0, 100).reduce("", (acc, _) => "${acc}a"),
        range(0, 100).reduce("", (acc, _) => "${acc}b")
      )).toBe(100)]
    )
  ])
