// Binary Search
//
// Given an ascending-sorted array xs and a target value, return the index of
// target in xs, or -1 if it is not present.
// Use a lo/hi loop — not a linear scan.
//
// Signature:
//   solve(xs: Int32[], target: Int32): Int32
//
// Examples:
//   solve([1, 3, 5, 7, 9], 5)   // 2
//   solve([1, 3, 5, 7, 9], 6)   // -1
//   solve([], 1)                 // -1
//   solve([4], 4)                // 0

export val solve = (xs: Int32[], target: Int32): Int32 =>
  -1
