import { expect, toBe, test, suite } from "std/test"
import { range, map } from "std/iter"

export val tests = (solve: (Int32[], Int32) => Int32): AnyVal =>
  suite("12-binary-search", [
    test("finds middle element", () =>
      [expect(solve([1, 3, 5, 7, 9], 5)).toBe(2)]
    ),

    test("absent element returns -1", () =>
      [expect(solve([1, 3, 5, 7, 9], 6)).toBe(-1)]
    ),

    test("empty array returns -1", () =>
      [expect(solve([], 1)).toBe(-1)]
    ),

    test("single-element array found", () =>
      [expect(solve([4], 4)).toBe(0)]
    ),

    test("first element", () =>
      [expect(solve([1, 3, 5, 7, 9], 1)).toBe(0)]
    ),

    test("last element", () =>
      [expect(solve([1, 3, 5, 7, 9], 9)).toBe(4)]
    ),

    test("single-element not found", () =>
      [expect(solve([4], 5)).toBe(-1)]
    ),

    test("two elements found first", () =>
      [expect(solve([3, 7], 3)).toBe(0)]
    ),

    test("two elements found second", () =>
      [expect(solve([3, 7], 7)).toBe(1)]
    ),

    test("large input: find element at index 500 in 0..999", () =>
      [expect(solve(range(0, 1000).map(i => i * 2), 1000)).toBe(500)]
    ),

    test("large input: target absent", () =>
      [expect(solve(range(0, 1000).map(i => i * 2), 999)).toBe(-1)]
    )
  ])
