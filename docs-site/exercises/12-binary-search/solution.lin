// Binary Search — reference solution.
import { length } from "std/array"

// The window is half-open [i, j), so the base case is the EMPTY window i >= j —
// a one-element window still holds an unchecked candidate. That guard must precede
// the xs[midIndex] read: on an empty window midIndex == i == j, which is out of bounds.
val find = (xs: Int32[], target: Int32, i: Int32, j: Int32): Int32 =>
  val midIndex = i + (j - i) / 2
  if i >= j then
    -1
  else if xs[midIndex] == target then
    midIndex
  else if target > xs[midIndex] then
    find(xs, target, midIndex + 1, j)
  else
    find(xs, target, i, midIndex)

export val solve = (xs: Int32[], target: Int32): Int32 =>
  find(xs, target, 0, xs.length())
