{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "onEnterRules": [
    {
      "beforeText": "^$",
      "afterText": "^\\S",
      "action": { "indent": "none" }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "(=>|\\bthen|\\belse)\\s*$|^\\s*match\\b",
    "decreaseIndentPattern": "^\\s*(else\\b(?!\\s*=>)|then\\b)"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}
