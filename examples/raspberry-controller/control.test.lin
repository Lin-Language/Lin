import { suite, test, expect, run, toBe } from "std/test"
import { clampSpeed, applyKey, KEY_LEFT_UP, KEY_LEFT_DOWN, KEY_RIGHT_UP, KEY_RIGHT_DOWN, KEY_STOP } from "./control"
import { encodePacket } from "./protocol"
import { f32FromBe } from "std/bytes"
import { length } from "std/array"

// Tests for the pure control core of the RC-car client (control.lin). The
// interactive runController (TTY + UDP loop, in main.lin) isn't unit-tested here
// — its pieces (encodePacket, applyKey, clampSpeed) are, and std/net/std/tty have
// their own coverage in the runtime test suites. Test bodies are Assertion[]
// arrays so every assertion runs.
val UNKNOWN_KEY = 120 // x

val s = suite("raspberry-control", [
  test("clampSpeed quantises to one decimal and clamps to [-1, 1]", () => [
    expect(clampSpeed(0.5)).toBe(0.5),
    expect(clampSpeed(0.15)).toBe(0.2), // rounds to nearest 0.1
    expect(clampSpeed(0.24)).toBe(0.2),
    expect(clampSpeed(1.5)).toBe(1.0), // clamps high
    expect(clampSpeed(-1.5)).toBe(-1.0) // clamps low
  ]),

  test("encodePacket is 8 bytes: two big-endian f32 motor speeds", () => [
    expect(encodePacket(0.0, 0.0).length()).toBe(8),
    // decode the two f32s back out (0.5 and -0.25 are exact in f32)
    expect(encodePacket(0.5, -0.25).f32FromBe(0)).toBe(0.5),
    expect(encodePacket(0.5, -0.25).f32FromBe(4)).toBe(-0.25)
  ]),

  test("encodePacket stop is all zero bytes", () => [
    expect(encodePacket(0.0, 0.0)).toBe([0, 0, 0, 0, 0, 0, 0, 0])
  ]),

  test("applyKey: q/a step left, w/s step right, space stops", () => [
    expect(applyKey(KEY_LEFT_UP, 0.0, 0.0)).toBe([0.1, 0.0]),
    expect(applyKey(KEY_LEFT_DOWN, 0.0, 0.0)).toBe([-0.1, 0.0]),
    expect(applyKey(KEY_RIGHT_UP, 0.0, 0.0)).toBe([0.0, 0.1]),
    expect(applyKey(KEY_RIGHT_DOWN, 0.0, 0.0)).toBe([0.0, -0.1]),
    expect(applyKey(KEY_STOP, 0.7, -0.4)).toBe([0.0, 0.0])
  ]),

  test("applyKey leaves the other wheel untouched", () => [
    expect(applyKey(KEY_LEFT_UP, 0.0, 0.3)).toBe([0.1, 0.3]),
    expect(applyKey(KEY_RIGHT_UP, 0.6, 0.0)).toBe([0.6, 0.1])
  ]),

  test("applyKey clamps at the boundary", () => [
    expect(applyKey(KEY_LEFT_UP, 1.0, 0.0)).toBe([1.0, 0.0]),
    expect(applyKey(KEY_RIGHT_DOWN, 0.0, -1.0)).toBe([0.0, -1.0])
  ]),

  test("applyKey ignores unknown keys", () => [
    expect(applyKey(UNKNOWN_KEY, 0.5, 0.3)).toBe([0.5, 0.3])
  ])
])

run(s)
