// Unit suite for lexer.lin — `tokenize` in isolation.
//
// Covers numbers (incl. multi-digit as one token), operators, parens, whitespace
// skipping, and the `bad` token emitted for unknown characters.
import { expect, toBe, test, suite, run } from "std/test"
import { tokenize, Token } from "./lexer"

val num = (t: String): Token => { "kind": "num", "text": t }
val op = (t: String): Token => { "kind": "op", "text": t }
val lp = (): Token => { "kind": "lparen", "text": "(" }
val rp = (): Token => { "kind": "rparen", "text": ")" }
val bad = (t: String): Token => { "kind": "bad", "text": t }

val s = suite("lexer", [
  // --- Numbers ---
  test("tokenizes a single-digit number as one token", () => [
    expect(tokenize("7")).toBe([num("7")])
  ]),

  test("tokenizes a multi-digit number as one token", () => [
    expect(tokenize("123")).toBe([num("123")])
  ]),

  // --- Operators ---
  test("tokenizes each arithmetic operator", () => [
    expect(tokenize("+-*/")).toBe([op("+"), op("-"), op("*"), op("/")])
  ]),

  // --- Parens ---
  test("tokenizes parentheses as lparen/rparen", () => [
    expect(tokenize("()")).toBe([lp(), rp()])
  ]),

  test("tokenizes operators and parens in order", () => [
    expect(tokenize("(1+2)")).toBe([lp(), num("1"), op("+"), num("2"), rp()])
  ]),

  // --- Whitespace ---
  test("skips spaces and tabs between tokens", () => [
    expect(tokenize("  1 +\t 2 ")).toBe([num("1"), op("+"), num("2")])
  ]),

  test("empty source yields no tokens", () => [
    expect(tokenize("")).toBe([]),
    expect(tokenize("   ")).toBe([])
  ]),

  // --- Bad characters ---
  test("emits a bad token for an unknown character", () => [
    expect(tokenize("@")).toBe([bad("@")])
  ]),

  test("a bad character is one token among the good ones", () => [
    expect(tokenize("1 @ 2")).toBe([num("1"), bad("@"), num("2")])
  ])
])
run(s)
