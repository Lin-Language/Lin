// Lexer for the calc expression language.
//
// Turns a source string into a flat token array. Each token is a small tagged
// object: { "kind": "num", "text": "12" } | { "kind": "op", "text": "+" } |
// { "kind": "lparen", "text": "(" } | { "kind": "rparen", "text": ")" } |
// { "kind": "bad", "text": "@" }.
import { charCode, substring, at } from "std/string"
import { push, length } from "std/array"
import { range, find, while } from "std/iter"

export type TokenKind = "num" | "op" | "lparen" | "rparen" | "bad"
export type Token = { "kind": TokenKind, "text": String }

// ASCII code points.
val TAB = 9
val NEWLINE = 10
val CARRIAGE_RETURN = 13
val SPACE = 32
val LPAREN = 40
val RPAREN = 41
val STAR = 42
val PLUS = 43
val MINUS = 45
val SLASH = 47
val DIGIT_0 = 48
val DIGIT_9 = 57

val isDigit = (c: Int32): Boolean =>
  c >= DIGIT_0 && c <= DIGIT_9

val isSpace = (c: Int32): Boolean =>
  c == SPACE || c == TAB || c == NEWLINE || c == CARRIAGE_RETURN

val isOperator = (c: Int32): Boolean =>
  c == PLUS || c == MINUS || c == STAR || c == SLASH

// End index (one past the last digit) of the number run starting at `start`.
val numberEnd = (src: String, start: Int32): Int32 =>
  range(start, src.length()).find(j => !isDigit(src.charCode(j))) ?? src.length()

// Lexes the character (or number run) at `i`, appending any token to `tokens`,
// and returns the index of the next unread character.
val lexAt = (src: String, i: Int32, tokens: Token[]): Int32 =>
  val c = src.charCode(i)
  if isSpace(c) then
    i + 1
  else if isDigit(c) then
    val end = numberEnd(src, i)
    tokens.push({ "kind": "num", "text": src.substring(i, end) })
    end
  else
    val kind: TokenKind = if c == LPAREN then
      "lparen"
    else if c == RPAREN then
      "rparen"
    else if isOperator(c) then
      "op"
    else
      "bad"
    tokens.push({ "kind": kind, "text": src.at(i) })
    i + 1

export val tokenize = (src: String): Token[] =>
  val tokens: Token[] = []
  var i = 0
  while(() =>
    if i < src.length() then
      i = lexAt(src, i, tokens)
      true
    else
      false
  )
  tokens
